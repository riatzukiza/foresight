{:event/id "934c8daf-50c1-4dd9-bb10-47cc40209a62", :event/parents ["93841148-b8a6-40b9-b2a8-2fa86c9dd86b"], :archaeology/topic "Knoxx content-addressed source revision and immutable admission snapshot identity laws", :archaeology/summary "Pressure-tested content-aligned snapshot/tail reconciliation against publication document admission with explicit revisions. Knoxx hashes source bytes into concrete revisions, content-addresses the complete trusted admission snapshot independently of wall-clock time, and causally links the durable indexed signal back to its immutable source snapshot. This is an identity-and-link law, not a generic content-overlap tail reconciler.", :archaeology/consumes [{:event/id "93841148-b8a6-40b9-b2a8-2fa86c9dd86b", :action/id :seed/continue-knoxx-shape-inventory, :relation :continues}], :archaeology/findings [{:finding/id :knoxx/admission-event-identity-addresses-trusted-snapshot, :finding/shapes #{:identity :projection :provenance}, :finding/current-name "document-admission/snapshot-binding + event-id + admission-events", :finding/candidate-name "TrustedSnapshotIdentity<Snapshot>", :finding/claim "Document admission derives snapshot and indexed event ids from the complete trusted snapshot binding rather than wall-clock time. An unchanged retry reuses both ids, while changed content/revision, provenance placement, scope, or draft policy mints new immutable identities. The event identity therefore records stronger provenance than a source path alone.", :evidence [:evidence.knoxx/document-admission-domain :evidence.knoxx/document-admission-domain-test]} {:finding/id :knoxx/indexed-signal-causally-names-source-snapshot, :finding/shapes #{:projection :relation :handoff}, :finding/current-name "document-admission/admission-events durable-extra + local-indexed-event", :finding/candidate-name "SnapshotSignalLink<Snapshot,Signal>", :finding/claim "Admission emits a durable searchable source snapshot and a durable indexed signal from the same immutable payload; the indexed signal records source_event_id and the local runtime event carries index/source-event-id naming the snapshot. This non-text pressure test does not use ContentAlignedSnapshotTail: changed state is represented by a new revision-qualified immutable fact plus an explicit causal link, not by overlap reconciliation.", :evidence [:evidence.knoxx/document-admission-domain :evidence.knoxx/document-admission-domain-test]} {:finding/id :knoxx/source-revision-is-content-addressed-not-path-versioned, :finding/shapes #{:identity :law :provenance}, :finding/current-name "publication-source-revision/content-revision + source-revisions!", :finding/candidate-name "ContentAddressedRevision<Bytes,Revision>", :finding/claim "Publication source revision is the full SHA-256 digest of source bytes with the algorithm named in the token. Equal bytes yield the same revision, changed bytes yield a different revision, absent content has no revision, and reads are rooted in the resource file's owning checkout after canonical containment checks. Source path locates bytes but is not version authority.", :evidence [:evidence.knoxx/publication-source-revision :evidence.knoxx/publication-source-revision-test]}], :archaeology/actions [#:action{:id :seed/continue-knoxx-shape-inventory, :type :next-investigation, :status :open, :description "Continue mining a fresh Knoxx shape family. Pressure-test ContentAddressedRevision<Bytes,Revision> or SnapshotSignalLink<Snapshot,Signal> against an independent child or provider boundary, and continue looking for provider identity seams where immutable occurrence provenance is stronger than transport aliases or source-path metadata."}], :evidence/refs [#:evidence{:id :evidence.knoxx/document-admission-domain, :repo "open-hax/knoxx", :path "backend/src/cljs/knoxx/backend/domain/document_admission.cljc", :commit "fb08a10a8aa32a594cc97ae11b820113de4cf386", :blob "8ca9c0427437c6656fee0729f77103e4c12a680e", :url "https://github.com/open-hax/knoxx/blob/fb08a10a8aa32a594cc97ae11b820113de4cf386/backend/src/cljs/knoxx/backend/domain/document_admission.cljc"} #:evidence{:id :evidence.knoxx/document-admission-domain-test, :repo "open-hax/knoxx", :path "backend/test/cljs/knoxx/backend/domain/document_admission_test.cljs", :commit "fb08a10a8aa32a594cc97ae11b820113de4cf386", :blob "ff286d5c2f1a7a444286aec012bbe77d1879a64e", :url "https://github.com/open-hax/knoxx/blob/fb08a10a8aa32a594cc97ae11b820113de4cf386/backend/test/cljs/knoxx/backend/domain/document_admission_test.cljs"} #:evidence{:id :evidence.knoxx/publication-source-revision, :repo "open-hax/knoxx", :path "backend/src/cljs/knoxx/backend/infra/publication_source_revision.cljs", :commit "fb08a10a8aa32a594cc97ae11b820113de4cf386", :blob "074de30642f61ccb2978a2c881905ad85b137a0f", :url "https://github.com/open-hax/knoxx/blob/fb08a10a8aa32a594cc97ae11b820113de4cf386/backend/src/cljs/knoxx/backend/infra/publication_source_revision.cljs"} #:evidence{:id :evidence.knoxx/publication-source-revision-test, :repo "open-hax/knoxx", :path "backend/test/cljs/knoxx/backend/infra/publication_source_revision_test.cljs", :commit "fb08a10a8aa32a594cc97ae11b820113de4cf386", :blob "c39faec97b5e952080dc989c3f9a40b83d1d9c56", :url "https://github.com/open-hax/knoxx/blob/fb08a10a8aa32a594cc97ae11b820113de4cf386/backend/test/cljs/knoxx/backend/infra/publication_source_revision_test.cljs"}]}
