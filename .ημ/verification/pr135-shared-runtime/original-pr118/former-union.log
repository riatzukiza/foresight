{:event/id "dcadf215-7b96-4bad-a11a-a5f5067546b9", :event/parents ["93841148-b8a6-40b9-b2a8-2fa86c9dd86b"], :archaeology/topic "Knoxx revision-qualified publication observation and consistent source revision cuts", :archaeology/summary "Consumed the selected explicit-revision observer pressure test by tracing publication source revision capture and static-site observation. Publication uses full content-derived revisions frozen once per reconciliation, while materialization observation is keyed by stable publication identity and reports a committed revision only when the manifest-named bytes exist. These laws are distinct from append-only ContentAlignedSnapshotTail replay.", :archaeology/consumes [{:event/id "93841148-b8a6-40b9-b2a8-2fa86c9dd86b", :action/id :seed/continue-knoxx-shape-inventory, :relation :consumes}], :archaeology/findings [{:finding/id :knoxx/materialization-observation-is-identity-and-revision-qualified, :finding/shapes #{:observer :projection :identity :revision}, :finding/current-name "publication-target-static-site/observe-publication!", :finding/candidate-name "RevisionQualifiedMaterializationObservation<Identity,Revision>", :finding/claim "The static-site observer addresses current publication state by stable publication id, not desired path, and reports the manifest route's concrete revision and path only when the referenced artifact bytes exist. Path moves remain the same logical publication, orphan bytes without a manifest route are invisible, and a manifest route whose bytes vanished is observed as absent so reconciliation may republish. Convergence is therefore revision-qualified equality over authoritative current state, not snapshot-tail suffix inference.", :evidence [:evidence.knoxx/publication-target-static-site :evidence.knoxx/publication-target-static-site-test]} {:finding/id :knoxx/publication-revision-cut-is-content-addressed, :finding/shapes #{:observer :projection :revision :reconciler}, :finding/current-name "publication-source-revision/source-revisions! + revision-facts", :finding/candidate-name "ConsistentRevisionCut<Document,Revision>", :finding/claim "Publication computes each readable document revision as a full algorithm-qualified SHA-256 digest and reads the revision map once before one reconciliation. Gate facts, desired translation work, authored receipt preparation, and publication planning consume that fixed map, so one reconciliation cannot admit against one source revision and publish against another. Missing sources are absent rather than assigned a synthetic revision. This is an explicit revision cut, not content-prefix replay.", :evidence [:evidence.knoxx/publication-runtime :evidence.knoxx/publication-source-revision :evidence.knoxx/publication-source-revision-test]} {:finding/id :knoxx/static-site-manifest-is-current-route-projection-not-history, :finding/shapes #{:projection :store :commit-boundary :revision}, :finding/current-name "publication-target-static-site/commit-route!", :finding/candidate-name "AtomicCurrentRouteProjection<Identity,Revision>", :finding/claim "The static-site manifest is the published fact and holds one current route per publication identity. A publish writes artifact bytes first, then atomically replaces the manifest under an exclusive lock, and only after that commit reclaims displaced artifact bytes. Equal route plus present bytes is a no-write replay. The structure is a current-state projection with an atomic commit point; it provides no history ordering or suffix law and must not be generalized as a replay log.", :evidence [:evidence.knoxx/publication-target-static-site :evidence.knoxx/publication-target-static-site-test]}], :archaeology/actions [#:action{:id :seed/continue-knoxx-shape-inventory, :type :next-investigation, :status :open, :description "Continue mining revision-qualified observers outside publication. Pressure-test ConsistentRevisionCut<Document,Revision> against a durable event or projection boundary with causal revisions, and keep RevisionQualifiedMaterializationObservation separate from append-only ContentAlignedSnapshotTail unless another domain proves a common equivalence law."}], :evidence/refs [#:evidence{:id :evidence.knoxx/publication-runtime, :repo "open-hax/knoxx", :path "backend/src/cljs/knoxx/backend/infra/publication_runtime.cljs", :commit "fb08a10a8aa32a594cc97ae11b820113de4cf386", :blob "1720c4abeed83c4552519fbabafa1de407711840", :url "https://github.com/open-hax/knoxx/blob/fb08a10a8aa32a594cc97ae11b820113de4cf386/backend/src/cljs/knoxx/backend/infra/publication_runtime.cljs"} #:evidence{:id :evidence.knoxx/publication-source-revision, :repo "open-hax/knoxx", :path "backend/src/cljs/knoxx/backend/infra/publication_source_revision.cljs", :commit "fb08a10a8aa32a594cc97ae11b820113de4cf386", :blob "074de30642f61ccb2978a2c881905ad85b137a0f", :url "https://github.com/open-hax/knoxx/blob/fb08a10a8aa32a594cc97ae11b820113de4cf386/backend/src/cljs/knoxx/backend/infra/publication_source_revision.cljs"} #:evidence{:id :evidence.knoxx/publication-source-revision-test, :repo "open-hax/knoxx", :path "backend/test/cljs/knoxx/backend/infra/publication_source_revision_test.cljs", :commit "fb08a10a8aa32a594cc97ae11b820113de4cf386", :blob "c39faec97b5e952080dc989c3f9a40b83d1d9c56", :url "https://github.com/open-hax/knoxx/blob/fb08a10a8aa32a594cc97ae11b820113de4cf386/backend/test/cljs/knoxx/backend/infra/publication_source_revision_test.cljs"} #:evidence{:id :evidence.knoxx/publication-target-static-site, :repo "open-hax/knoxx", :path "backend/src/cljs/knoxx/backend/infra/publication_target_static_site.cljs", :commit "fb08a10a8aa32a594cc97ae11b820113de4cf386", :blob "7f85d075e4cc24c6e51f79da09d403d2fff03ef3", :url "https://github.com/open-hax/knoxx/blob/fb08a10a8aa32a594cc97ae11b820113de4cf386/backend/src/cljs/knoxx/backend/infra/publication_target_static_site.cljs"} #:evidence{:id :evidence.knoxx/publication-target-static-site-test, :repo "open-hax/knoxx", :path "backend/test/cljs/knoxx/backend/infra/publication_target_static_site_test.cljs", :commit "fb08a10a8aa32a594cc97ae11b820113de4cf386", :blob "9da0ad2d825f55991debd360c1be5fc4f4785680", :url "https://github.com/open-hax/knoxx/blob/fb08a10a8aa32a594cc97ae11b820113de4cf386/backend/test/cljs/knoxx/backend/infra/publication_target_static_site_test.cljs"}]}
